          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本各地で野良猫の不妊・去勢手術を支援しています。"
          }
        }
      }
    },
    "Funds spay/neuter access and veterinary care." : {
