    "Five Escapes detected. Keyboard unlocked for 5 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfmal Escape erkannt. Tastatur für 5 Minuten entsperrt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq pressions sur Échap détectées. Clavier déverrouillé pendant 5 minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapeキーが5回押されました。キーボードを5分間ロック解除します。"
