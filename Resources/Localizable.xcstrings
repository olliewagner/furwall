    "Alley Cat Allies" : {
      "shouldTranslate" : false
    },
    "Backs Germany's largest network of animal shelters and cat rescues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trägt Deutschlands größtes Netzwerk von Tierheimen und Katzenhilfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soutient le plus grand réseau de refuges et de sauvetages félins en Allemagne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドイツ最大の動物保護施設・猫救護ネットワークを支える。"
          }
        }
      }
    },
    "Blocks catasstrophes." : {
      "comment" : "Tagline. Pun on cat + catastrophes. DE/FR have native portmanteau words (Katzastrophe, chatastrophe); JA has no equivalent so the pun is dropped for an idiomatic line that captures the protective spirit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert Katzastrophen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évite les chatastrophes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猫のいたずらを未然に防ぎます。"
          }
        }
      }
    },
    "Camera access required" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerazugriff erforderlich"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès à la caméra requis"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラアクセスが必要"
          }
        }
      }
    },
    "Camera frames are processed entirely on your Mac with Apple’s Vision framework. Furwall never uploads, transmits, or stores video. Accessibility access is used solely to drop keystrokes when no human is present—keystrokes are never read, logged, or transmitted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerabilder werden vollständig auf Ihrem Mac mit Apples Vision-Framework verarbeitet. Furwall lädt, überträgt oder speichert niemals Videos. Der Zugriff auf Bedienungshilfen wird ausschließlich genutzt, um Tastatureingaben zu unterdrücken, wenn kein Mensch anwesend ist – Tastatureingaben werden niemals gelesen, protokolliert oder übertragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images de la caméra sont traitées entièrement sur votre Mac avec le framework Vision d’Apple. Furwall ne télécharge, ne transmet et ne stocke jamais de vidéo. L’accès à l’accessibilité sert uniquement à supprimer les frappes au clavier en l’absence d’un humain — les frappes ne sont jamais lues, enregistrées ni transmises."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの映像はすべて、AppleのVisionフレームワークを使ってMac内で処理されます。Furwallが映像をアップロード、送信、保存することはありません。アクセシビリティ権限は、人がいないときにキー入力を抑制する目的のみに使用されます。キー入力が読み取られたり、記録されたり、送信されることはありません。"
          }
        }
      }
    },
    "Cat Protection Society of NSW" : {
      "shouldTranslate" : false
    },
    "Cats Protection" : {
      "shouldTranslate" : false
    },
