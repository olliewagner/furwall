    "Funds free spay/neuter for stray cats across Japan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanziert kostenlose Sterilisation für Streunerkatzen in ganz Japan."
          }
